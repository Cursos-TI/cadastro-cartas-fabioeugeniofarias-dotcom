#include <stdio.h>

typedef unsigned long int ulint;

typedef struct {
char estado;
    char codigo[8];
    char nomeCidade[100];
    ulint populacao;        // agora unsigned long int
    float area;             // km²
    float pib;              // em bilhões de reais
    int pontosTuristicos;
    float densidade;        // hab/km²
    float pibPerCapita;     // em reais
    float superPoder;       // soma dos atributos (float)
} Carta;

void cadastrarCarta(Carta *c) {
    printf("Informe o estado (A-H): ");
    scanf(" %c", &c->estado);

    printf("Informe o código da carta (ex: A01): ");
    scanf("%7s", c->codigo);

    printf("Informe o nome da cidade: ");
    scanf(" %[^\n]", c->nomeCidade);

    printf("Informe a população: ");
    scanf("%lu", &c->populacao);

    printf("Informe a área (em km²): ");
    scanf("%f", &c->area);

    printf("Informe o PIB (em bilhões de reais): ");
    scanf("%f", &c->pib);

    printf("Informe o número de pontos turísticos: ");
    scanf("%d", &c->pontosTuristicos);

   // Cálculos
   if (c->area > 0.0f && c->populacao > 0) {
        c->densidade = (float)c->populacao / c->area;
        c->pibPerCapita = (c->pib * 1e9f) / (float)c->populacao;
    } else {
        // proteção contra divisão por zero
        c->densidade = 0.0f;
        c->pibPerCapita = 0.0f;
    } 

    float invDens = 0.0f;
    if (c->densidade > 0.0f) invDens = 1.0f / c->densidade;

    c->superPoder =
        (float)c->populacao
        + c->area
        + c->pib
        + (float)c->pontosTuristicos
        + c->pibPerCapita
        + invDens;
    }

void mostrarCarta(const Carta *c, int idx) {
    printf("\n=== Carta %d ===\n", idx);
    printf("Estado: %c\n", c->estado);
    printf("Código: %s\n", c->codigo);
    printf("Nome da Cidade: %s\n", c->nomeCidade);
    printf("População: %lu\n", c->populacao);
    printf("Área: %.2f km²\n", c->area);
    printf("PIB: %.2f bilhões de reais\n", c->pib);
    printf("Número de Pontos Turísticos: %d\n", c->pontosTuristicos);
    printf("Densidade Populacional: %.2f hab/km²\n", c->densidade);
    printf("PIB per Capita: %.2f reais\n", c->pibPerCapita);
    printf("Super Poder: %.6e (forma científica)\n", (double)c->superPoder);
}

int main() {
    Carta c1, c2;

    printf("Desafio Trunfo! Nível Mestre - Batalha de Cartas\n\n");

    printf("=== Cadastro da Carta 1 ===\n");
    cadastrarCarta(&c1);

    printf("\n=== Cadastro da Carta 2 ===\n");
    cadastrarCarta(&c2);

    mostrarCarta(&c1, 1);
    mostrarCarta(&c2, 2);

    printf("\nComparação de Cartas:\n\n");

    int pop_vence = (c1.populacao > c2.populacao) ? 1 : 0;
    printf("População: Carta 1 venceu (%d)\n\n", pop_vence);

    int area_vence = (c1.area > c2.area) ? 1 : 0;
    printf("Área: Carta 1 venceu (%d)\n\n", area_vence);

    int pib_vence = (c1.pib > c2.pib) ? 1 : 0;
    printf("PIB: Carta 1 venceu (%d)\n\n", pib_vence);

    int pts_vence = (c1.pontosTuristicos > c2.pontosTuristicos) ? 1 : 0;
    printf("Pontos Turísticos: Carta 1 venceu (%d)\n\n", pts_vence);

    int dens_vence = (c1.densidade < c2.densidade) ? 1 : 0;
    printf("Densidade Populacional: Carta 1 venceu (%d)\n\n", dens_vence);

    int ppc_vence = (c1.pibPerCapita > c2.pibPerCapita) ? 1 : 0;
    printf("PIB per Capita: Carta 1 venceu (%d)\n\n", ppc_vence);

    int sp_vence = (c1.superPoder > c2.superPoder) ? 1 : 0;
    printf("Super Poder: Carta 1 venceu (%d)\n\n", sp_vence);

return 0;
}


































